# ==============================================================
# MoodTunes AI - Environment Configuration Template
# Copy this file to '.env' and fill in your actual credentials.
# ==============================================================

# Spotify API (Optional - for playlist importing & metadata)
SPOTIFY_CLIENT_ID=your_spotify_client_id_here
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret_here

# YouTube Data API v3 (Optional - automatic web scraper fallback active)
YOUTUBE_API_KEY=your_youtube_api_key_here

# Google Gemini AI (For emotion analysis & intelligent playlist curation)
GEMINI_API_KEY=your_gemini_api_key_here

# Last.fm API (For music tags, artist info & recommendations)
LASTFM_API_KEY=your_lastfm_api_key_here
LASTFM_API_SECRET=your_lastfm_api_secret_here

# Deepgram API (For voice-to-text / Voice DJ)
DEEPGRAM_API_KEY=your_deepgram_api_key_here

# Groq API (For conversational chatbot copilot)
GROQ_API_KEY=your_groq_api_key_here

# MongoDB Configuration (Cloud Atlas or Local)
# Leave blank to seamlessly use local JSON file persistence
MONGODB_URL=mongodb+srv://<username>:<password>@cluster.mongodb.net/moodtunes?retryWrites=true&w=majority

# JWT Authentication Secret Key (Set a secure random string in production)
JWT_SECRET_KEY=change_this_to_a_secure_random_string_in_production
